  m_Script: {fileID: 11500000, guid: 4e54ef0d220210343bd1afb93b700b74, type: 3}
  m_Name: Library_Memory
  m_EditorClassIdentifier: TidyUp.Runtime::TidyUp.Story.MemoryDefinition
  _id: memory_library
  _title: The Day Before
  _locationName: The Library, Culture Quarter
  _lines:
  - Speaker: 
    Text: Half past eight in the evening. Rain on the tall windows, and one last reader asleep over a crossword.
    Duration: 5.5
  - Speaker: Ms. Penhallow, the librarian
    Text: Novels by author, atlases by volume, picture books tallest first. A place for everything.
    Duration: 5.5
  - Speaker: 
    Text: 'On the returns desk lay a card for a book she had never seen: City Atlas, Volume Eleven. The Streets That Aren''t There.'
    Duration: 6.5
  - Speaker: Ms. Penhallow, the librarian
    Text: 'We have only ever had ten volumes. And look: a tiny, floury handprint on the card.'
    Duration: 6
  - Speaker: 
    Text: She tucked the card under the lamp to ask about in the morning, and locked the door.
    Duration: 5
  - Speaker: 
    Text: By morning, every book had gone wandering, and Volume Eleven was nowhere to be found.
    Duration: 5.5
  _clue: 'A return card for City Atlas, Volume Eleven: ''The Streets That Aren''t There'', a book the library never owned, signed with a tiny, floury handprint.'
